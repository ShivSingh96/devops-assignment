terraform {
  required_version = ">= 1.3.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

# Run with credentials for Account A (000000000000)
provider "aws" {
  region = var.region
}

variable "region" {
  type    = string
  default = "us-east-1"
}

variable "account_a_id" {
  type    = string
  default = "000000000000"
}

variable "account_b_id" {
  type    = string
  default = "111111111111"
}

# Must match the role name created in account-b
variable "role_c_name" {
  type    = string
  default = "roleC"
}

# Console users for group2: two named users of my choice
variable "console_users" {
  type    = set(string)
  default = ["alice.admin", "bob.dev"]
}

locals {
  role_c_arn = "arn:aws:iam::${var.account_b_id}:role/${var.role_c_name}"
}

# ---------- group1: programmatic only (no console password is ever created) ----------

resource "aws_iam_user" "engine" {
  name = "engine"
}

resource "aws_iam_user" "ci" {
  name = "ci"
}

resource "aws_iam_group" "group1" {
  name = "group1"
}

resource "aws_iam_group_membership" "group1" {
  name  = "group1-membership"
  group = aws_iam_group.group1.name
  users = [aws_iam_user.engine.name, aws_iam_user.ci.name]
}

# Group policy: lets group1 call AssumeRole on roleB, and nothing else
data "aws_iam_policy_document" "group1_assume_role_b" {
  statement {
    effect    = "Allow"
    actions   = ["sts:AssumeRole"]
    resources = [aws_iam_role.role_b.arn]
  }
}

resource "aws_iam_group_policy" "group1" {
  name   = "assume-roleB"
  group  = aws_iam_group.group1.name
  policy = data.aws_iam_policy_document.group1_assume_role_b.json
}

# Task 4: the least-privilege CI policy, attached directly to the ci user
resource "aws_iam_user_policy" "ci" {
  name   = "ci-pipeline"
  user   = aws_iam_user.ci.name
  policy = file("${path.module}/../../task4-ci-policy/ci-policy.json")
}

# ---------- group2: console + CLI ----------

resource "aws_iam_user" "console" {
  for_each = var.console_users
  name     = each.key
}

# Console password. Generated by AWS and stored in state; user must reset at first login.
resource "aws_iam_user_login_profile" "console" {
  for_each                = aws_iam_user.console
  user                    = each.value.name
  password_reset_required = true
}

resource "aws_iam_group" "group2" {
  name = "group2"
}

resource "aws_iam_group_membership" "group2" {
  name  = "group2-membership"
  group = aws_iam_group.group2.name
  users = [for u in aws_iam_user.console : u.name]
}

# Self-service password change (required for password_reset_required to work)
resource "aws_iam_group_policy_attachment" "group2_change_password" {
  group      = aws_iam_group.group2.name
  policy_arn = "arn:aws:iam::aws:policy/IAMUserChangePassword"
}

data "aws_iam_policy_document" "group2_assume_role_a" {
  statement {
    effect    = "Allow"
    actions   = ["sts:AssumeRole"]
    resources = [aws_iam_role.role_a.arn]
  }
}

resource "aws_iam_group_policy" "group2" {
  name   = "assume-roleA"
  group  = aws_iam_group.group2.name
  policy = data.aws_iam_policy_document.group2_assume_role_a.json
}

# ---------- roleA: admin on everything except IAM ----------

data "aws_iam_policy_document" "role_a_trust" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]

    principals {
      type        = "AWS"
      identifiers = [for u in aws_iam_user.console : u.arn]
    }
  }
}

resource "aws_iam_role" "role_a" {
  name               = "roleA"
  assume_role_policy = data.aws_iam_policy_document.role_a_trust.json
}

# NotAction + Allow means "everything except iam:*". Anything not allowed is implicitly denied.
data "aws_iam_policy_document" "role_a_permissions" {
  statement {
    effect      = "Allow"
    not_actions = ["iam:*"]
    resources   = ["*"]
  }

  # Explicit deny so a future policy attached to this role cannot re-grant IAM
  statement {
    effect    = "Deny"
    actions   = ["iam:*"]
    resources = ["*"]
  }
}

resource "aws_iam_role_policy" "role_a" {
  name   = "admin-except-iam"
  role   = aws_iam_role.role_a.id
  policy = data.aws_iam_policy_document.role_a_permissions.json
}

# ---------- roleB: can only assume roleC in Account B ----------

data "aws_iam_policy_document" "role_b_trust" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]

    principals {
      type        = "AWS"
      identifiers = [aws_iam_user.engine.arn, aws_iam_user.ci.arn]
    }
  }
}

resource "aws_iam_role" "role_b" {
  name               = "roleB"
  assume_role_policy = data.aws_iam_policy_document.role_b_trust.json
}

data "aws_iam_policy_document" "role_b_permissions" {
  statement {
    effect    = "Allow"
    actions   = ["sts:AssumeRole"]
    resources = [local.role_c_arn]
  }
}

resource "aws_iam_role_policy" "role_b" {
  name   = "assume-roleC-in-account-b"
  role   = aws_iam_role.role_b.id
  policy = data.aws_iam_policy_document.role_b_permissions.json
}

output "role_b_arn" {
  value = aws_iam_role.role_b.arn
}

output "role_a_arn" {
  value = aws_iam_role.role_a.arn
}
